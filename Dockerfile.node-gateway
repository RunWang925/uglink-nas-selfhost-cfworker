# syntax=docker/dockerfile:1.7

FROM node:22.23.3-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN node scripts/build-node-gateway.mjs \
    && test -f dist/node-gateway/index.mjs

FROM node:22.23.3-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="UGLINK Node Gateway" \
      org.opencontainers.image.description="Self-hosted UGREENlink gateway (no Cloudflare) with per-port service mapping and traffic accounting" \
      org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production

WORKDIR /app

COPY --from=build --chown=node:node /app/dist/node-gateway ./dist

RUN mkdir -p /data \
    && chown node:node /data

USER node
VOLUME ["/data"]
STOPSIGNAL SIGTERM

ENTRYPOINT ["node", "/app/dist/index.mjs"]
